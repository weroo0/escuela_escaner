<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Logo/Icono principal -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_school"
            android:padding="24dp"
            android:background="@drawable/icon_background" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Título principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_busqueda"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escanea o ingresa el número del alumno"
        android:textSize="16sp"
        android:textColor="@color/white_transparent"
        android:layout_marginBottom="40dp"
        android:gravity="center" />

    <!-- Card principal del formulario -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Campo de entrada -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/hint_busqueda"
                app:boxStrokeColor="@color/primary_blue"
                app:hintTextColor="@color/primary_blue"
                app:startIconDrawable="@drawable/ic_person_search"
                app:startIconTint="@color/primary_blue"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBusqueda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textSize="18sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón registrar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/btn_buscar"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="15dp"
                app:backgroundTint="@color/primary_blue"
                app:rippleColor="@color/ripple_blue"
                app:elevation="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Área de resultados -->
    <LinearLayout
        android:id="@+id/resultados_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- EditText invisible para el escáner -->
    <EditText
        android:id="@+id/etScanInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:inputType="text"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible" />

    <!-- Botón volver -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_volver"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/white"
        android:textColor="@color/primary_blue"
        app:cornerRadius="25dp"
        app:strokeColor="@color/primary_blue"
        app:strokeWidth="2dp" />

</LinearLayout>
